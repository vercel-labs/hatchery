{
  "build": {
    "env": {
      "VERCEL_CLI_VERSION": "vercel@58.9.1"
    }
  },
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "pyproject.toml"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/channels/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [{ "path": "/api/cron/parity", "schedule": "0 9 * * *" }]
}
