{
  "services": {
    "app": {
      "root": "backend/",
      "entrypoint": "pyproject.toml",
      "buildCommand": "cd frontend && corepack pnpm install --frozen-lockfile && corepack pnpm build"
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
