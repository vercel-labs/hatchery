# Cloud deployments supply Queue and Sandbox configuration automatically.
# For local development, run scripts/reverse_proxy.sh and export the printed
# public origin before starting `vercel dev`:
# HATCHERY_PUBLIC_URL=https://your-vgrok-origin.example
# AI_GATEWAY_API_KEY=[redacted]

# Dispatcher traces are sent to Braintrust when both values are set.
# BRAINTRUST_API_KEY=[redacted]
# BRAINTRUST_PARENT=project_id:your-project-id
