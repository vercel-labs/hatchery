# Cloud deployments supply Queue and Sandbox configuration automatically.
# For local development, run scripts/reverse_proxy.sh and export the printed
# public origin before starting `vercel dev`:
# HATCHERY_PUBLIC_URL=https://your-vgrok-origin.example
# AI_GATEWAY_API_KEY=[redacted]
# Exact comma-separated emails allowed to use this deployment. Missing or empty denies everyone.
# HATCHERY_ALLOWED_EMAILS=alice@vercel.com,bob@vercel.com
# Vercel sends `Authorization: Bearer $CRON_SECRET` to the minute heartbeat.
# Generate separate long random values and set them on the backend service.
# CRON_SECRET=
# ROTOR_RELEASE_SECRET=

# Rotor uses DATABASE_URL for durable state. Give it the direct Neon URL for
# LISTEN/NOTIFY; the application continues using the pooled URL above.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Onboarding stores the private GitHub memory repository in app settings.
# These remain deployment-level fallbacks for migration and local development.
# HATCHERY_AGENTS_REPOSITORY_URL=https://github.com/owner/private-agents.git
# HATCHERY_AGENTS_REPOSITORY_INSTALLATION_ID=
# HATCHERY_AGENTS_REPOSITORY_BRANCH=main
# Local fallback only; do not expose this token to sandboxes.
# HATCHERY_AGENTS_REPOSITORY_TOKEN=

# Dispatcher traces are sent to Braintrust when both values are set.
# BRAINTRUST_API_KEY=[redacted]
# BRAINTRUST_PARENT=project_id:your-project-id
